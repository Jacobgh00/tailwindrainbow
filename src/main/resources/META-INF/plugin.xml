<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.tailwindrainbow</id>
    <name>Tailwind Rainbow</name>
    <vendor url="https://github.com/Jacobgh00/tailwindRainbow">Jacobgh00</vendor>

    <description><![CDATA[
        Colorizes Tailwind CSS variant prefixes so long class lists stay readable.
        <p>Each variant — <code>hover</code>, <code>focus</code>, <code>sm</code>, <code>dark</code>,
        arbitrary values such as <code>[&amp;>*]</code>, and the <code>!</code> important modifier —
        is painted in its own color, making the structure of a class list visible at a glance.</p>
        <p>Works in HTML, JSX/TSX, Vue, Svelte, Astro, PHP, and in CSS <code>@apply</code> directives.
        Colors, themes, and the recognized attributes, helper functions, and file types are configurable
        under <b>Settings | Editor | Tailwind Rainbow</b>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.TailwindRainbowBundle</resource-bundle>

    <extensionPoints>
        <!-- Other plugins contribute themes here; see adapter.theme.ThemeContributor. -->
        <extensionPoint name="themeContributor"
                        interface="dev.tailwindrainbow.intellij.adapter.theme.ThemeContributor"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <annotator
                language=""
                implementationClass="dev.tailwindrainbow.intellij.adapter.intellij.highlighting.TailwindRainbowAnnotator"/>

        <projectConfigurable
                parentId="editor"
                instance="dev.tailwindrainbow.intellij.adapter.intellij.settings.ui.TailwindRainbowSettingsConfigurable"
                id="dev.tailwindrainbow.intellij.settings"
                bundle="messages.TailwindRainbowBundle"
                key="configurable.displayName"/>

        <localInspection language=""
                         implementationClass="dev.tailwindrainbow.intellij.adapter.intellij.inspection.UncolouredVariantInspection"
                         bundle="messages.TailwindRainbowBundle"
                         key="inspection.uncoloured.name"
                         groupPath="Tailwind Rainbow"
                         groupName="Tailwind Rainbow"
                         level="WEAK WARNING"
                         enabledByDefault="true"/>

        <statusBarWidgetFactory id="dev.tailwindrainbow.statusBar"
                                implementation="dev.tailwindrainbow.intellij.adapter.intellij.statusbar.TailwindStatusWidgetFactory"
                                order="after positionWidget"/>
    </extensions>

    <actions>
        <action id="dev.tailwindrainbow.SelectTheme"
                class="dev.tailwindrainbow.intellij.adapter.intellij.actions.SelectThemeAction"/>

        <action id="dev.tailwindrainbow.ExplainColouring"
                class="dev.tailwindrainbow.intellij.adapter.intellij.actions.ExplainColouringAction"/>
    </actions>
</idea-plugin>
